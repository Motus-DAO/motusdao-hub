# Import this file in Vercel → Settings → Environment Variables → Import .env
# Fill PASTE_* from motusdao-hub/.env.local
#
# Hosts are locked in the Hub. A missing NEXT_PUBLIC_JITSI_DOMAIN does not
# fall back to meet.jit.si. Do not point a therapy room at meet.jit.si.
# Therapy:  jitsi.motusdao.org  (JITSI_APP_SECRET = private JWT_APP_SECRET)
# Open:     meet.motusdao.org   (JITSI_OPEN_APP_SECRET = a different secret)

JITSI_APP_ID=motusdao
JITSI_APP_SECRET=PASTE_PRIVATE_JITSI_JWT_APP_SECRET
JITSI_OPEN_APP_ID=motusdao-open
JITSI_OPEN_APP_SECRET=PASTE_OPEN_JITSI_JWT_APP_SECRET_DIFFERENT_FROM_THERAPY

NEXT_PUBLIC_JITSI_OFFICE_PREFIX=motusdao-office-
NEXT_PUBLIC_JITSI_ROOM_PREFIX=motusdao-sess-
NEXT_PUBLIC_JITSI_METAVERSE_PREFIX=motusdao-meta-
NEXT_PUBLIC_JITSI_OPEN_PREFIX=motusdao-open-
# Optional sandbox (local/staging): rooms without matching
# NEXT_PUBLIC_JITSI_QUICK_PREFIX=motusdao-quick-
# NEXT_PUBLIC_JITSI_QUICK_ROOMS=true

AUTH_SECRET=PASTE_FROM_ENV_LOCAL
NEXT_PUBLIC_APP_URL=https://PASTE_YOUR_PRODUCTION_DOMAIN
DATABASE_URL=PASTE_FROM_ENV_LOCAL
